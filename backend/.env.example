NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/sweepers_dev

FRONTEND_URL=http://localhost:3000

JWT_SECRET=your_super_secret_jwt_key_here_must_be_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_must_be_long
